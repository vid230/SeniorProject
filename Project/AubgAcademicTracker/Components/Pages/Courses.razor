@page "/courses"

<PageTitle>Courses</PageTitle>

<h1>Courses</h1>

<p>
	Manage all courses used for GPA and credit calculations.
</p>

<button class="btn btn-primary mb-3">
	+ Add Course
</button>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Code</th>
			<th>Course Name</th>
			<th>Credits</th>
			<th>Grade</th>
			<th>Semester</th>
			<th>Actions</th>
		</tr>
	</thead>

	<tbody>
		<tr>
			<td>COS 120</td>
			<td>Intro to Computing</td>
			<td>3</td>
			<td>A-</td>
			<td>Fall 2025</td>
			<td>
				<button class="btn btn-sm btn-outline-primary">
					Edit
				</button>

				<button class="btn btn-sm btn-outline-danger">
					Delete
				</button>
			</td>
		</tr>

		<tr>
			<td>COS 221</td>
			<td>Data Structures</td>
			<td>3</td>
			<td>B+</td>
			<td>Spring 2026</td>
			<td>
				<button class="btn btn-sm btn-outline-primary">
					Edit
				</button>

				<button class="btn btn-sm btn-outline-danger">
					Delete
				</button>
			</td>
		</tr>
	</tbody>
</table>