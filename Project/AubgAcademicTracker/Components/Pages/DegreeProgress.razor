@page "/degree-progress"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject CourseService CourseService
@inject DegreeProgressService DegreeProgressService

<PageTitle>Degree Progress</PageTitle>

<h1>Degree Progress</h1>

@if (progress == null)
{
	<p>Loading...</p>
}
else
{
	<div class="row">

		<div class="col-md-4 mb-3">
			<div class="card">
				<div class="card-body">
					<h5>Earned Credits</h5>
					<h2>@progress.EarnedCredits</h2>
				</div>
			</div>
		</div>

		<div class="col-md-4 mb-3">
			<div class="card">
				<div class="card-body">
					<h5>Remaining Credits</h5>
					<h2>@progress.RemainingCredits</h2>
				</div>
			</div>
		</div>

		<div class="col-md-4 mb-3">
			<div class="card">
				<div class="card-body">

					<h5>Progress</h5>

					<h2>
						@progress.ProgressPercentage.ToString("0.0")%
					</h2>

				</div>
			</div>
		</div>

	</div>

	<div class="progress mt-3" style="height: 30px;">

		<div class="progress-bar" role="progressbar" style="@($"width: {progress.ProgressPercentage}%")">

			@progress.ProgressPercentage.ToString("0.0")%

		</div>

	</div>

	<p class="mt-3">
		@progress.EarnedCredits of @progress.RequiredCredits required credits completed.
	</p>
}

@code {

}