@page "/add-semester"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject SemesterService SemesterService
@inject NavigationManager Navigation

<PageTitle>Add Semester</PageTitle>

<h1>Add Semester</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EditForm Model="@semester" OnValidSubmit="@SaveSemester">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Term</label>

        <InputSelect class="form-select" @bind-Value="semester.Term">
            <option value="">-- Select term --</option>
            <option value="Fall">Fall</option>
            <option value="Spring">Spring</option>
            <option value="Summer">Summer</option>
        </InputSelect>

        <ValidationMessage For="@(() => semester.Term)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Year</label>

        <InputNumber class="form-control" @bind-Value="semester.Year" />

        <ValidationMessage For="@(() => semester.Year)" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Semester
    </button>

    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
        Cancel
    </button>
</EditForm>

@code
{
    private Semester semester = new()
    {
        Year = DateTime.Now.Year
    };

    private string errorMessage = string.Empty;

    private async Task SaveSemester()
    {
        bool added = await SemesterService.AddSemesterAsync(semester);

        if (!added)
        {
            errorMessage = "This semester already exists.";
            return;
        }

        Navigation.NavigateTo("/semesters");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/semesters");
    }
}