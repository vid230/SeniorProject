@page "/courses"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services
@using Microsoft.JSInterop

@inject CourseService CourseService
@inject IJSRuntime JS

<PageTitle>Courses</PageTitle>

<h1>Courses</h1>

<p>Manage all courses used for GPA and credit calculations.</p>

<a class="btn btn-primary mb-3" href="/add-course">+ Add Course</a>

@if (courses.Count == 0)
{
    <div class="alert alert-info">
        No courses have been added yet.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Course Name</th>
                <th>Credits</th>
                <th>Grade</th>
                <th>Semester</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (Course course in courses)
            {
                <tr>
                    <td>@course.Code</td>
                    <td>@course.Name</td>
                    <td>@course.Credits</td>
                    <td>@course.Grade</td>
                    <td>@course.Semester</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary me-2" href="@($"/edit-course/{course.Id}")">
                            Edit
                        </a>

                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCourse(course.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code
{
    private List<Course> courses = new();

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetCoursesAsync();
    }

    private async Task DeleteCourse(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this course?");

        if (!confirmed)
        {
            return;
        }

        await CourseService.DeleteCourseAsync(id);

        courses = await CourseService.GetCoursesAsync();
    }
}