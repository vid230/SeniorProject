@page "/semesters/{Id:int}"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject SemesterService SemesterService
@inject GpaCalculator GpaCalculator

<PageTitle>Semester Details</PageTitle>

@if (semester == null)
{
    <p>Loading semester...</p>
}
else
{
    <h1>@semester.DisplayName</h1>

    <p>
        Semester GPA:
        <strong>@GpaCalculator.CalculateGpa(semester.Courses).ToString("0.00")</strong>
    </p>

    @if (semester.Courses.Count == 0)
    {
        <div class="alert alert-info">
            This semester does not contain any courses yet.
        </div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Course Name</th>
                    <th>Credits</th>
                    <th>Grade</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Course course in semester.Courses)
                {
                    <tr>
                        <td>@course.Code</td>
                        <td>@course.Name</td>
                        <td>@course.Credits</td>
                        <td>@course.Grade</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a class="btn btn-secondary" href="/semesters">
        Back
    </a>
}

@code
{
    [Parameter]
    public int Id { get; set; }

    private Semester? semester;

    protected override async Task OnParametersSetAsync()
    {
        semester = await SemesterService.GetSemesterByIdAsync(Id);
    }
}