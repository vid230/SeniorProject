@page "/course-planner"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject CoursePlannerService CoursePlannerService

<PageTitle>Course Planner</PageTitle>

<h1>Course Prerequisite Planner</h1>

<p class="text-muted">
	Add the courses you want to plan, define prerequisite relationships, and generate a valid course order.
</p>

<hr />

<h3>1. Add Planned Course</h3>

<EditForm Model="@newCourse" OnInvalidSubmit="@AddCourse">

	<DataAnnotationsValidator></DataAnnotationsValidator>
	<ValidationSummary></ValidationSummary>

	<div class="mb-3">
		<label class="form-label">
			Course Code
		</label>

		<InputText class="form-control" @bind-Value="newCourse.Code"></InputText>

		<ValidationMessage For="@(() => newCourse.Code)"></ValidationMessage>
	</div>

	<div class="mb-3">
		<label class="form-label">
			Course Name
		</label>

		<InputText class="form-control" @bind-Value="newCourse.Name"></InputText>

		<ValidationMessage For="@(() => newCourse.Name)"></ValidationMessage>
	</div>

	<div class="mb-3">
		<label class="form-label">
			Credits
		</label>

		<InputNumber class="form-control" @bind-Value="newCourse.Credits"></InputNumber>

		<ValidationMessage For="@(() => newCourse.Credits)"></ValidationMessage>
	</div>

	<button type="submit" class="btn btn-primary">
		Add Planned Course
	</button>

</EditForm>

<hr />

<h3>Planned Courses</h3>

@if (plannedCourses.Count == 0)
{
	<div class="alert alert-info">
		No planned courses have been added yet.
	</div>
}
else
{
	<table class="table table-striped">

		<thead>
			<tr>
				<th>Code</th>
				<th>Course Name</th>
				<th>Credits</th>
				<th>Action</th>
			</tr>
		</thead>

		<tbody>

			@foreach (PlannedCourse course in plannedCourses)
			{
				<tr>
					<td>@course.Code</td>
					<td>@course.Name</td>
					<td>@course.Credits</td>

					<td>
						<button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCourse(course)">
							Remove
						</button>
					</td>
				</tr>
			}

		</tbody>
	</table>
}

@if (plannedCourses.Count >= 2)
{
	<hr />

	<h3>2. Add Prerequisite Relationship</h3>

	<p class="text-muted">
		Select which course must be completed before another course.
	</p>

	<EditForm Model="@newRelation" OnInvalidSubmit="@AddRelation">

		<div class="mb-3">

			<label class="form-label">
				Prerequisite Course
			</label>

			<InputSelect class="form-select" @bind-Value="newRelation.PrerequisiteCode">

				<option value="">
					-- Select prerequisite --
				</option>

				@foreach (PlannedCourse course in plannedCourses)
				{
					<option value="@course.Code">
						@course.Code - @course.Name
					</option>
				}

			</InputSelect>

		</div>

		<div class="mb-3">

			<label class="form-label">
				Dependent Course
			</label>

			<InputSelect class="form-select" @bind-Value="newRelation.CourseCode">

				<option value="">
					-- Select course --
				</option>

				@foreach (PlannedCourse course in plannedCourses)
				{
					<option value="@course.Code">
						@course.Code - @course.Name
					</option>
				}

			</InputSelect>

		</div>

		<button type="submit" class="btn btn-primary">
			Add Prerequisite
		</button>

	</EditForm>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
	<div class="alert alert-danger mt-3">
		@errorMessage
	</div>
}

<hr />

<h3>Prerequisite Relationships</h3>

@if (relations.Count == 0)
{
	<div class="alert alert-info">
		No prerequisite relationships have been added.
	</div>
}
else
{
	<table class="table table-bordered">

		<thead>
			<tr>
				<th>Prerequisite</th>
				<th></th>
				<th>Course</th>
				<th>Action</th>
			</tr>
		</thead>

		<tbody>

			@foreach (PrerequisiteRelation relation in relations)
			{
				<tr>
					<td>
						@relation.PrerequisiteCode
					</td>

					<td>
						->
					</td>

					<td>
						@relation.CourseCode
					</td>

					<td>
						<button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveRelation(relation)">
							Remove
						</button>
					</td>
				</tr>
			}

		</tbody>

	</table>
}

@if (plannedCourse.Count > 0)
{
	<hr />

	<h3>3. Generate Course Order</h3>

	<button class="btn btn-success me-2" @onclick="GeneratePlan">
		Generate Course Order
	</button>

	<button class="btn btn-secondary" @onclick="ClearPlanner">
		Clear Planner
	</button>
}

@if (result != null)
{
	<hr />

	<h3>Course Plan Result</h3>

	@if (result.Success)
	{
		<div class="alert alert-success">
			@result.Message
		</div>

		<table class="table table-striped">

			<thead>
				<tr>
					<th>Order</th>
					<th>Course Code</th>
					<th>Course Name</th>
					<th>Credits</th>
				</tr>
			</thead>

			<tbody>

				@for (int i = 0; i < result.OrderedCourses.Count; i++)
				{
					PlannedCourse course = result.OrderedCourses[i];

					<tr>
						<td>@(i + 1)</td>
						<td>@course.Code</td>
						<td>@course.Name</td>
						<td>@course.Credits</td>
					</tr>
				}

			</tbody>

		</table>
	}
	else
	{
		<div class="alert alert-danger">
			@result.Message
		</div>

		@if (result.HasCycle)
		{
			<p>
				The prerequisite graph contains a cycle, so a valid topological ordering does not exist.
			</p>
		}
	}

	<p>
		Courses in graph:
		<strong>@result.VertexCount</strong>
	</p>

	<p>
		Prerequisite relationships:
		<strong>@result.EdgeCount</strong>
	</p>
}

@code
{
	private List<PlannedCourse> plannedCourses = new();

	private List<PrerequisiteRelation> relations = new();

	private PlannedCourse newCourse = new();

	private PrerequisiteRelation newRelation = new();

	private CoursePlanResult? result;

	private string errorMessage = string.Empty;

	private void AddCourse()
	{
		errorMessage = string.Empty;

		string normalizedCode = newCourse.Code.Trim();

		bool alreadyExists = plannedCourses.Any(course => string.Equals(course.Code, normalizedCode, StringComparison.OrdinalIgnoreCase));

		if (alreadyExists)
		{
			errorMessage = "A course with this code already exists.";

			return;
		}

		plannedCourses.Add(
		new PlannedCourse
		{
			Code = normalizedCode,
			Name = newCourse.Name.Trim(),
			Credits = newCourse.Credits
		});

		newCourse = new PlannedCourse();

		result = null;
	}

	private void RemoveCourse(PlannedCourse course)
	{
		plannedCourses.Remove(course);

		relations.RemoveAll(relation => string.Equals(relation.PrerequisiteCode, course.Code, StringComparison.OrdinalIgnoreCase)
		|| string.Equals(relation.CourseCode, course.Code, StringComparison.OrdinalIgnoreCase));

		result = null;
		errorMessage = string.Empty;
	}
}
