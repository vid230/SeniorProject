@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject CourseService CourseService
@inject GpaCalculator GpaCalculator
@inject CreditCalculator CreditCalculator

@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>Academic Dashboard</h1>

<p class="text-muted">
    Overview of your academic progress.
</p>

<div class="row">
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    Cumulative GPA
                </h5>

                <h2>@cumulativeGpa.ToString("0.00")</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    Earned Credits
                </h5>

                <h2>@earnedCredits</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    Attempted Credits
                </h5>

                <h2>@attemptedCredits</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">
                    Courses Completed
                </h5>

                <h2>@completedCourses</h2>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a class="btn btn-primary me-2" href="/courses">
        View Courses
    </a>

    <a href="/add-course" class="btn btn-success me-2">
        Add Course
    </a>
</div>

@code
{
    private List<Course> courses = new();

    private double cumulativeGpa;
    private int attemptedCredits;
    private int earnedCredits;
    private int completedCourses;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetCoursesAsync();

        cumulativeGpa = GpaCalculator.CalculateGpa(courses);

        attemptedCredits = CreditCalculator.CalculateAttemptedCredits(courses);

        earnedCredits = CreditCalculator.CalculateEarnedCredits(courses);

        completedCourses = CreditCalculator.CalculateCompletedCourses(courses);
    }
}