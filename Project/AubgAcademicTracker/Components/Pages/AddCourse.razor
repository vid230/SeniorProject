@page "/add-course"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject CourseService CourseService
@inject NavigationManager Navigation

<PageTitle>Add Course</PageTitle>

<h1>Add Course</h1>

<p>Enter the information for the course.</p>

<EditForm Model="@course" OnValidSubmit="@SaveCourse">
	<DataAnnotationsValidator></DataAnnotationsValidator>

	<ValidationSummary></ValidationSummary>

	<div class="mb-3">
		<label class="form-label">Course Code</label>

		<InputText class="form-control" @bind-Value="course.Code"></InputText>

		<ValidationMessage For="@(() => course.Code)"></ValidationMessage>
	</div>

	<div class="mb-3">
		<label class="form-label">Credits</label>

		<InputNumber class="form-control" @bind-Value="course.Credits"></InputNumber>

		<ValidationMessage For="@(() => course.Credits)"></ValidationMessage>
	</div>

	<div class="mb-3">
		<label class="form-label">Grade</label>

		<InputSelect class="form-select" @bind-Value="course.Grade">
			<option value="">-- Select grade --</option>

			@foreach (string grade in grades)
			{
				<option value="@grade">@grade</option>
			}
		</InputSelect>

		<ValidationMessage For="@(() => course.Grade)"></ValidationMessage>
	</div>

	<div class="m-3">
		<label class="form-label">Semester</label>

		<InputText class="form-control" @bind-Value="course.Semester" placeholder="Example: Fall 2026"></InputText>

		<ValidationMessage For="@(() => course.Semester)"></ValidationMessage>
	</div>

	<button type="submit" class="btn btn-primary">
		Save Course
	</button>

	<button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
		Cancel
	</button>
</EditForm>

@code {
	private Course course = new();

	private readonly string[] grades =
		{
			"A",
			"A-",
			"B+",
			"B",
			"B-",
			"C+",
			"C",
			"C-",
			"D+",
			"D",
			"F"
	};

	private void SaveCourse()
	{
		CourseService.AddCourse(course);

		Navigation.NavigateTo("/courses");
	}

	private void Cancel()
	{
		Navigation.NavigateTo("/courses");
	}
}