@page "/add-semester"

@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject SemesterService SemesterService
@inject NavigationManager Navigation

<PageTitle>Add Semester</PageTitle>

<h1>Add Semester</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
	<div class="alert alert-danger">
		@errorMessage
	</div>
}

<EditForm Model="@semester" OnValidSubmit="@SaveSemester">
	<DataAnnotationsValidator></DataAnnotationsValidator>
	<ValidationSummary></ValidationSummary>

	<div class="mb-3">
		<label class="form-label">Term</label>

		<InputSelect class="form-select" @bind-Value="semester.Term">
			<option value="">-- Select term --</option>
			<option value="Fall">Fall</option>
			<option value="Spring">Spring</option>
			<option value="Summer">Summer</option>
		</InputSelect>

		<ValidationMessage For="@(() => semester.Term)"></ValidationMessage>
	</div>

	<div class="mb-3">
		<label class="form-label">Year</label>

		<InputNumber class="form-control" @bind-Value="semester.Year"></InputNumber>

		<ValidationMessage For="@(() => Semester.Year)"></ValidationMessage>
	</div>

	<button type="submit" class="btn btn-primary">
		Save Semester
	</button>

	<button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">
		Cancel
	</button>
</EditForm>

