@using AubgAcademicTracker.Models
@using AubgAcademicTracker.Services

@inject CourseService CourseService
@inject GpaCalculator GpaCalculator
@inject CreditCalculator CreditCalculator

@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>AUBG Academic Progress Tracker</h1>

<p class="lead">
    Track your courses, GPA, credits, semesters and degree progress.
</p>

<hr />

<h2>Academic Overview</h2>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card p-3">
            <h5>Current GPA</h5>
            <h2>0.00</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Earned Credits</h5>
            <h2>0</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Attempted Credits</h5>
            <h2>0</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3">
            <h5>Courses Completed</h5>
            <h2>0</h2>
        </div>
    </div>
</div>

<hr class="mt-4" />

<h2>Tools</h2>

<div class="mt-3">
    <a class="btn btn-primary me-2" href="/courses">
        Courses
    </a>

    <button class="btn btn-secondary me-2" disabled>
        Semesters
    </button>

    <button class="btn btn-secondary me-2" disabled>
        What-if Calculator
    </button>

    <button class="btn btn-secondary" disabled>
        Degree Progress
    </button>
</div>

@code
{
    private List<Course> courses = new();

    private double cumulativeGpa;
    private int attemptedCredits;
    private int earnedCredits;
    private int completedCourses;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetCoursesAsync();

        cumulativeGpa = GpaCalculator.CalculateGpa(courses);

        attemptedCredits = CreditCalculator.CalculateAttemptedCredits(courses);

        earnedCredits = CreditCalculator.CalculateEarnedCredits(courses);

        completedCourses = CreditCalculator.CalculateCompletedCourses(courses);
    }
}